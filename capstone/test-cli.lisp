;; Subprocess regression tests for the SBCL-specific driver.
(require :asdf)
(defpackage #:course-tasks.cli-tests (:use #:cl))
(in-package #:course-tasks.cli-tests)

(defun run-tests (script)
  (let ((checks 0))
    (uiop:with-temporary-file (:pathname path :stream stream :keep nil)
      (close stream)
      (delete-file path)
      (flet ((run (arguments expected-code &optional expected-text)
               (multiple-value-bind (out err code)
                   (uiop:run-program
                    (append (list (or (uiop:getenv "COURSE_SBCL") "sbcl")
                                  "--noinform" "--no-sysinit" "--no-userinit"
                                  "--script" (namestring script))
                            arguments)
                    :directory (uiop:temporary-directory)
                    :output :string :error-output :string :ignore-error-status t)
                 (incf checks)
                 (assert (= code expected-code) ()
                         "CLI ~S returned ~D: ~A ~A" arguments code out err)
                 (when expected-text (assert (search expected-text out)))
                 err)))
        (let ((file (namestring path)))
          (run '("help") 0 "Usage:")
          (run nil 2)
          (run '("unknown") 2)
          (run '("list") 2)
          (run '("help" "extra") 2)
          (run (list "list" file) 0)
          (assert (not (probe-file path)))
          (run (list "add" file "Read the course") 0 "Added 1:")
          (run (list "add" file "Write Lisp") 0 "Added 2:")
          (run (list "list" file) 0 "1 [ ] Read the course")
          (run (list "done" file "1") 0 "Completed 1.")
          (run (list "done" file "1") 0)
          (run (list "list" file) 0 "1 [x] Read the course")
          (let ((before (uiop:read-file-string path)))
            (run (list "done" file "99") 1)
            (run (list "done" file "3x") 1)
            (run (list "done" file "0") 1)
            (run (list "add" file "  ") 1)
            (assert (string= before (uiop:read-file-string path))))
          (with-open-file (out path :direction :output :if-exists :supersede)
            (write-string "(:version 99 :next-id 1 :tasks nil)" out))
          (run (list "add" file "Must not overwrite invalid data") 1)
          (assert (search ":version 99" (uiop:read-file-string path)))
          (with-open-file (out path :direction :output :if-exists :supersede)
            (write-string "#.(error \"must not execute\")" out))
          (assert (search "Reader rejected" (run (list "list" file) 1))))))
    (format t "CLI: ~D subprocess checks passed.~%" checks)))

(run-tests (merge-pathnames "cli.lisp" *load-truename*))
